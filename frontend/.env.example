# Server-only. Never prefix any of these with NEXT_PUBLIC_ (the build refuses credential-like names).

# Base address of the platform API, e.g. http://127.0.0.1:8000/api/v1
API_BASE_URL=
# The site token (X-Raqam-Site-Token); same value as API_SITE_TOKEN in the backend.
API_SITE_TOKEN=
# Public address of this website, exactly its origin: https://<host>, with or without www as the real address is (the
# other one redirects), no path, no closing slash. The forms take only requests whose Origin is this; the build and the
# server refuse anything else (http only for localhost and 127.0.0.1).
SITE_URL=
# Where the platform's pictures and uploaded videos are served from, for the content security policy: origins only,
# separated by spaces or commas. Empty: the origin of API_BASE_URL. Read when the site is built.
MEDIA_ORIGINS=https://media.example.org
# The platform's webhook secret: the same value as SITE_WEBHOOK_SECRET in the backend, whose SITE_WEBHOOK_URL is
# https://<this site>/api/revalidate. Without it every webhook is refused and pages refresh only on their time limits.
SITE_WEBHOOK_SECRET=
# Cloudflare Turnstile's site key (public by design, read on the server). Without it the newsletter form is left out.
TURNSTILE_SITE_KEY=
# 1 behind Cloudflare: the visitor's address is CF-Connecting-IP. Otherwise it is the last X-Forwarded-For entry,
# the one this site's own reverse proxy added.
TRUST_CLOUDFLARE=
# Memory for rendered pages (cache-handler.js), in MB. Default 256.
PAGE_CACHE_MAX_MB=
# The IndexNow key: the same value as INDEXNOW_KEY in the backend. The site serves it at /{key}.txt so search engines
# trust the platform's pings. Empty: no such file.
INDEXNOW_KEY=
